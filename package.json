    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "wrangler": "^3.0.0"
  },
  "keywords": ["chatbot", "league-of-legends", "ai", "cloudflare-pages"],
