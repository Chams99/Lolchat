{
  "name": "lolchat",
  "version": "1.0.0",
  "description": "League of Legends Chatbot with secure API handling",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:cf": "wrangler pages dev . --port 8788",
